  "memory_count": 34,
  "memories": [
    {
      "memory_id": "mm001",
      "scene_id": "1",
      "scene_order": 1,
      "scene_title": "第1场",
      "identity_phase": "past_life_monkey_king",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r001"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我一拳把唐僧打倒，他那啰嗦劲儿像一堆苍蝇在我耳朵里嗡个没完，烦得我只想让整个世界立刻清净下来。"
    },
    {
      "memory_id": "mm002",
      "scene_id": "1",
      "scene_order": 1,
      "scene_title": "第1场",
      "identity_phase": "past_life_monkey_king",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r002"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我嘴上喊着要跟观音决一死战，结果还是被她收进甘露瓶里，憋屈得动弹不得，连那点硬气都像被一起压了下去。"
    },
    {
      "memory_id": "mm003",
      "scene_id": "2",
      "scene_order": 2,
      "scene_title": "第2场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r001"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我命令兄弟们跟我去杀春三十娘，可一回头才发现他们全躲到了门外，只剩我一个人硬扛。我嘴里还喊着“想杀我哪有那么容易”，结果转眼就五体投地跪下求饶，连我自己都没想到会怂成这样。"
    },
    {
      "memory_id": "mm004",
      "scene_id": "3",
      "scene_order": 3,
      "scene_title": "第3场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r003"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我被二当家一脚踩灭了下身的火，竟发现自己的七伤拳突然全好了，一拳打出去，伤口也不再痛了。"
    },
    {
      "memory_id": "mm005",
      "scene_id": "3",
      "scene_order": 3,
      "scene_title": "第3场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r004"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我剃了胡子，换上书生衣裳想讨晶晶姑娘欢心，谁知道她嫌我没了胡子就没了性格，还张口骂我是臭猴子。"
    },
    {
      "memory_id": "mm006",
      "scene_id": "4",
      "scene_order": 4,
      "scene_title": "第4场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r005"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我拿着照妖镜对白晶晶说我不是孙悟空，她盯着镜子里的影子，突然崩溃大哭，又一下扑进我怀里；可眼看就要成事，她又猛地把我推开，说白天不行。"
    },
    {
      "memory_id": "mm007",
      "scene_id": "4",
      "scene_order": 4,
      "scene_title": "第4场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r006"
      ],
      "merge_note": "kept_directly",
      "memory_text": "水帘洞里那幅画自己烧了起来，空中还传来声音，说我前世是罪孽深重的孙悟空，只要戴上金刚圈就能变回齐天大圣，可代价是从此断掉一切情欲。"
    },
    {
      "memory_id": "mm028",
      "scene_id": "4",
      "scene_order": 4,
      "scene_title": "第4场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r003_legacy"
      ],
      "merge_note": "Added to preserve existing Task3 support about 菩提老祖以葡萄化身现身并交付照妖镜。",
      "memory_text": "我捡到一串葡萄，才知道那竟是菩提老祖化身来救我；他还塞给我一把照妖镜，叫我去照白晶晶。"
    },
    {
      "memory_id": "mm029",
      "scene_id": "4",
      "scene_order": 4,
      "scene_title": "第4场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r004_legacy"
      ],
      "merge_note": "Added to preserve existing Task3 support about 菩提老祖说明唐僧以命换孙悟空重生、并需继续取经。",
      "memory_text": "菩提老祖告诉我，这些妖怪都在等唐三藏重现人间；五百年前唐僧用自己的命换来孙悟空五百年后重生，还得由我护着他再去取西经。"
    },
    {
      "memory_id": "mm008",
      "scene_id": "5",
      "scene_order": 5,
      "scene_title": "第5场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r007"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我冲进盘丝洞时，只看见晶晶倒在地上，脸色发白，手里还攥着短剑，血都流进了石缝里。我跪下去喊她，可她再也没睁开眼。"
    },
    {
      "memory_id": "mm009",
      "scene_id": "5",
      "scene_order": 5,
      "scene_title": "第5场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r008"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我攥着月光宝盒，一遍遍念“般若般罗密”，红光一次次闪起来，可我每次赶回去时，看到的还是晶晶躺在那里，怎么都来不及。"
    },
    {
      "memory_id": "mm010",
      "scene_id": "6",
      "scene_order": 6,
      "scene_title": "第6场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r009"
      ],
      "merge_note": "kept_directly",
      "memory_text": "她手一挥，我脚心突然剧痛，像被烙铁烫过一样。我低头一看，三颗痣赫然长在脚底，心里当场就是一麻。"
    },
    {
      "memory_id": "mm011",
      "scene_id": "6",
      "scene_order": 6,
      "scene_title": "第6场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r010"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我举起照妖镜，镜子里偏偏显出一只猴子的模样。我嘴上连喊几声“我不信”，可脚底那三颗痣和水帘洞里的话一起压上来，整个人都僵住了。"
    },
    {
      "memory_id": "mm030",
      "scene_id": "6",
      "scene_order": 6,
      "scene_title": "第6场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r005_legacy"
      ],
      "merge_note": "Added to preserve existing Task3 support about 月光宝盒被少女抢走。",
      "memory_text": "我本想拦住那个闯进盘丝洞的少女，结果被她一挥手打倒，月光宝盒也被她顺手抢走了。"
    },
    {
      "memory_id": "mm012",
      "scene_id": "7",
      "scene_order": 7,
      "scene_title": "第7场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r011"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我接过她那把从不离身的紫青宝剑，拔出来看了看，又装作若无其事地插了回去。"
    },
    {
      "memory_id": "mm013",
      "scene_id": "7",
      "scene_order": 7,
      "scene_title": "第7场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r012"
      ],
      "merge_note": "kept_directly",
      "memory_text": "她闭着眼等我亲下去，我却硬是拦住她，非要她先把月光宝盒拿出来。她说我骗她，那一刻我不是没心软，只是还是不肯松口。"
    },
    {
      "memory_id": "mm031",
      "scene_id": "7",
      "scene_order": 7,
      "scene_title": "第7场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r007_legacy"
      ],
      "merge_note": "Added to preserve existing Task3 support about 用信物骗青霞交出月光宝盒。",
      "memory_text": "我跟她说，要借她最重要的信物去骗她姐姐交出月光宝盒，只要一得手我就能带她一起脱身。"
    },
    {
      "memory_id": "mm032",
      "scene_id": "8",
      "scene_order": 8,
      "scene_title": "第8场",
      "identity_phase": "awakening_transition",
      "source_roles": [
        "至尊宝",
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r003",
        "scene8:manual_merge"
      ],
      "merge_note": "Added to preserve existing Task3 support about 至尊宝在时空错位中目睹孙悟空与观音、唐僧的旧业冲突。",
      "memory_text": "我眼看着“孙悟空”和观音吵到翻脸，他张口就骂“三八婆”，还嚷着既然避不了就决一死战；唐僧却宁肯一命赔一命也要换他活路。我冲去抢月光宝盒时，还被那一下法杖砸得眼前发黑。"
    },
    {
      "memory_id": "mm014",
      "scene_id": "9",
      "scene_order": 9,
      "scene_title": "第9场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r013"
      ],
      "merge_note": "kept_directly",
      "memory_text": "剑尖抵到喉咙那一下，我干脆把那句谎话说到底，说如果上天再给我一次机会，我会对那个女孩说“我爱你”，期限是一万年。话一出口，紫霞的剑就掉了，她眼里全是泪。"
    },
    {
      "memory_id": "mm015",
      "scene_id": "9",
      "scene_order": 9,
      "scene_title": "第9场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r014"
      ],
      "merge_note": "kept_directly",
      "memory_text": "铁扇公主和牛魔王同时逼我表态时，我看着紫霞，脱口说出了“她是我的发妻”。话刚说完，我就看见紫霞那眼神变了，像是真的把这句话信进去了。"
    },
    {
      "memory_id": "mm016",
      "scene_id": "10",
      "scene_order": 10,
      "scene_title": "第10场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r015"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我一拳把唐僧打倒，吼着让他别再唱那该死的 Only You。我是真的被他折磨得快疯了。"
    },
    {
      "memory_id": "mm017",
      "scene_id": "10",
      "scene_order": 10,
      "scene_title": "第10场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r016"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我指着紫霞身上的伤，对铁扇公主硬说人是我杀的，还让她去毁尸灭迹。嘴上说得狠，可话一出口，连我自己心里都往下一沉。"
    },
    {
      "memory_id": "mm033",
      "scene_id": "10",
      "scene_order": 10,
      "scene_title": "第10场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r009_legacy"
      ],
      "merge_note": "Added to preserve existing Task3 support about 半夜脱身未果、被唐僧拦下絮叨。",
      "memory_text": "半夜我溜出洞房，本来只想去找紫霞，结果先被八戒和沙僧拦住，又被唐僧叫进牢里絮叨个没完。我一边拼命说自己不是孙悟空，一边只想赶紧脱身。"
    },
    {
      "memory_id": "mm018",
      "scene_id": "11",
      "scene_order": 11,
      "scene_title": "第11场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r017"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我一睁眼就看见紫霞还在那儿，心里一急，爬起来就冲她要月光宝盒。她偏偏笑嘻嘻地说忘了拿，吓得我魂都快飞了。"
    },
    {
      "memory_id": "mm019",
      "scene_id": "11",
      "scene_order": 11,
      "scene_title": "第11场",
      "identity_phase": "mortal_zhizunbao",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r018"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我跑到悬崖边，原本想假装跳下去骗走铁扇公主，连鞋都特地摆在崖边做样子，结果她一喊我名字，我自己脚下一滑，反倒真的掉了下去。"
    },
    {
      "memory_id": "mm020",
      "scene_id": "12",
      "scene_order": 12,
      "scene_title": "第12场",
      "identity_phase": "awakening_transition",
      "source_roles": [
        "至尊宝",
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r019",
        "至尊宝:r005"
      ],
      "merge_note": "manually_merged_transition_memory",
      "memory_text": "我在盘丝洞醒来，先听菩提说我昏迷时一口气叫了紫霞七百八十四次，后来又变成七百八十五次，还追着问我爱一个人到底需不需要理由。我嘴上还拿晶晶当借口，可那句“不需要吗”却像钉子一样留在脑子里，怎么甩都甩不掉。"
    },
    {
      "memory_id": "mm021",
      "scene_id": "12",
      "scene_order": 12,
      "scene_title": "第12场",
      "identity_phase": "awakening_transition",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r004"
      ],
      "merge_note": "manually_kept_transition_memory",
      "memory_text": "我梦见紫霞对我说，她像飞蛾扑火一样，明知道会受伤还是要扑上来。醒来后，我看见墙上有只蜘蛛在爬，而她那串金铃竟挂在洞外的树枝上，心一下就乱了。"
    },
    {
      "memory_id": "mm022",
      "scene_id": "13",
      "scene_order": 13,
      "scene_title": "第13场",
      "identity_phase": "awakening_transition",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r021"
      ],
      "merge_note": "kept_directly",
      "memory_text": "我扯开衣裳，让春三十娘把我的心挖出来看看。晶晶走了，朋友也死了，我只想知道那个女人到底在我心里留下了什么。"
    },
    {
      "memory_id": "mm023",
      "scene_id": "13",
      "scene_order": 13,
      "scene_title": "第13场",
      "identity_phase": "awakening_transition",
      "source_roles": [
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r022"
      ],
      "merge_note": "kept_directly",
      "memory_text": "戴上金箍前，我终于把那句话说了出来：如果上天再给我一次机会，我会对那个女孩子说“我爱你”，期限是一万年。"
    },
    {
      "memory_id": "mm024",
      "scene_id": "14",
      "scene_order": 14,
      "scene_title": "第14场",
      "identity_phase": "returned_monkey_king",
      "source_roles": [
        "至尊宝",
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r023",
        "至尊宝:r006"
      ],
      "merge_note": "manually_merged_transition_memory",
      "memory_text": "我踩着七彩祥云翻下来，披上金甲圣衣，手里提着金箍棒。紫霞一叫我至尊宝，我就咬死自己是齐天大圣；可等她追上来、那串金铃从我怀里掉出来时，我又一下子什么都说不出口了。"
    },
    {
      "memory_id": "mm025",
      "scene_id": "14",
      "scene_order": 14,
      "scene_title": "第14场",
      "identity_phase": "returned_monkey_king",
      "source_roles": [
        "至尊宝",
        "至尊宝"
      ],
      "source_memory_refs": [
        "至尊宝:r007",
        "至尊宝:r023"
      ],
      "merge_note": "manually_merged_transition_memory",
      "memory_text": "紫霞扑过来抱住我，转眼就替我挡下了牛魔王那一叉。她倒在我怀里，说自己猜中了前头，却猜不中这结局；我喊了她的名字，可金箍越收越紧，我只能眼睁睁看着她飘走。"
    },
    {
      "memory_id": "mm026",
      "scene_id": "15",
      "scene_order": 15,
      "scene_title": "第15场",
      "identity_phase": "returned_monkey_king",
      "source_roles": [
        "至尊宝"
      ],
