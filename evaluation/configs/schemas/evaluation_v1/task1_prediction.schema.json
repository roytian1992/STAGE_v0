{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage://evaluation_v1/task1_prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_state", "developments_since_previous_checkpoint", "unresolved_threads"],
  "properties": {
    "current_state": {"$ref": "#/$defs/claims"},
    "developments_since_previous_checkpoint": {"$ref": "#/$defs/claims"},
    "unresolved_threads": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence_scene_orders"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence_scene_orders": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
